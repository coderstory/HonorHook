<?xml version="1.0" encoding="utf-8"?>
<!--
  卡哇伊重设计（2026-11-04）：小幽灵抱金锁吉祥物。
  画布 108x108，安全区 18~90，主体落在 34~80。分层：白幽灵（波浪裙摆）+ 大眼睛 +
  腮红 + 微笑 + 怀抱金锁（挂锁）。可爱三要素：头身比 1:1 大头、高光眼、腮红。
-->
<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 幽灵身体：白色，圆头顶 + 三段波浪裙摆 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M36,66 L36,48 A18,18 0 0 1 72,48 L72,66 A6,6 0 0 1 60,66 A6,6 0 0 1 48,66 A6,6 0 0 1 36,66 Z" />
    <!-- 幽灵暗部投影（左侧月牙，淡灰蓝，增加体积感） -->
    <path
        android:fillColor="#33000000"
        android:pathData="M36,66 L36,48 A18,18 0 0 1 43,34.6 A14,14 0 0 0 40,48 L40,66 A4.5,4.5 0 0 0 45,70.3 A6,6 0 0 1 36,66 Z" />
    <!-- 小手臂：两侧小圆手扒在锁上 -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M45.5,66 m-4,0 a4,4 0 1 1 8,0 a4,4 0 1 1 -8,0 Z" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M62.5,66 m-4,0 a4,4 0 1 1 8,0 a4,4 0 1 1 -8,0 Z" />

    <!-- 眼睛：大椭圆黑瞳 + 高光 -->
    <path android:fillColor="#FF3A3A48" android:pathData="M46,50 m-3.2,0 a3.2,4.2 0 1 1 6.4,0 a3.2,4.2 0 1 1 -6.4,0 Z" />
    <path android:fillColor="#FF3A3A48" android:pathData="M62,50 m-3.2,0 a3.2,4.2 0 1 1 6.4,0 a3.2,4.2 0 1 1 -6.4,0 Z" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M47,48.4 m-1.1,0 a1.1,1.1 0 1 1 2.2,0 a1.1,1.1 0 1 1 -2.2,0 Z" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M63,48.4 m-1.1,0 a1.1,1.1 0 1 1 2.2,0 a1.1,1.1 0 1 1 -2.2,0 Z" />

    <!-- 腮红：粉色椭圆 -->
    <path android:fillColor="#99FF9FB8" android:pathData="M40.5,56 m-2.6,0 a2.6,1.7 0 1 1 5.2,0 a2.6,1.7 0 1 1 -5.2,0 Z" />
    <path android:fillColor="#99FF9FB8" android:pathData="M67.5,56 m-2.6,0 a2.6,1.7 0 1 1 5.2,0 a2.6,1.7 0 1 1 -5.2,0 Z" />

    <!-- 微笑：小圆弧描边 -->
    <path
        android:strokeColor="#FF3A3A48"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M51.5,55 Q54,57.6 56.5,55" />

    <!-- 金锁：锁体圆角矩形 + 锁梁，挂在幽灵怀里 -->
    <path
        android:strokeColor="#FFE8A93D"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M50.5,64 L50.5,61 A3.5,3.5 0 0 1 57.5,61 L57.5,64" />
    <path android:fillColor="#FFFFD166" android:pathData="M47.5,64 L60.5,64 A2.5,2.5 0 0 1 63,66.5 L63,72 A2.5,2.5 0 0 1 60.5,74.5 L47.5,74.5 A2.5,2.5 0 0 1 45,72 L45,66.5 A2.5,2.5 0 0 1 47.5,64 Z" />
    <!-- 锁孔 -->
    <path android:fillColor="#FFB27C1E" android:pathData="M54,67.5 m-1.5,0 a1.5,1.5 0 1 1 3,0 a1.5,1.5 0 1 1 -3,0 Z" />
    <path android:fillColor="#FFB27C1E" android:pathData="M53.2,68.5 L54.8,68.5 L54.4,71.5 L53.6,71.5 Z" />

    <!-- 头顶呆毛：一根小卷毛，增加可爱度 -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,30 Q52,25.5 55.5,24 Q59,22.5 58,26" />
</vector>
