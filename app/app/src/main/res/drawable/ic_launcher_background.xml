<!--
  launcher 背景层 v3「液态玻璃色场」：模拟失焦玻璃后的色彩场。
  结构 = 深色基底 + 四团彩色散景（旋转椭圆、三段 linear 渐隐模拟高斯斑）。
  约束：只用 linear（radial 在 MagicOS 启动器解码失败，2026-11-04 实锤）；
  椭圆用标准双半圆 idiom（直径弧，无小半径/短弦风险）。
-->
<vector android:height="108.0dp" android:width="108.0dp" android:viewportWidth="108.0" android:viewportHeight="108.0"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <!-- 基底：对角青→蓝→紫 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="0" android:startY="0" android:endX="108" android:endY="108" android:type="linear">
                <item android:offset="0.0" android:color="#FF00C2B9" />
                <item android:offset="0.45" android:color="#FF2C6FFF" />
                <item android:offset="1.0" android:color="#FF8A41FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 散景 1：薄荷青斑（左上） -->
    <path android:pathData="M26,20 m-30,0 a30,22 0 1 0 60,0 a30,22 0 1 0 -60,0 Z" android:rotation="-18" android:pivotX="26" android:pivotY="20">
