                <item android:offset="0.0" android:color="#0087F5E4" />
                <item android:offset="0.5" android:color="#FF8FF5E4" />
                <item android:offset="1.0" android:color="#0087F5E4" />
            </gradient>
        </aapt:attr>
    </path>

