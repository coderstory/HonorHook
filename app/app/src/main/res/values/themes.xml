<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 宿主 UI 主题：仅需 NoActionBar（界面全部由 Miuix Compose 绘制）。
         windowBackground/splash 系列全部指到 splash_bg：冷启动先见系统启动画面，再接到自绘 splash，
         两者同底色且系统图标位留空（splash_blank），不会先闪一个大号应用图标。 -->
    <style name="Theme.HonorHook" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_bg</item>
    </style>
</resources>
