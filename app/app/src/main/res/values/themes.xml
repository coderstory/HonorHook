<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
  <!-- 窗口主题：结构照 LSPFRIDA values/themes.xml（Base.AppTheme + AppTheme 双层，
       显式 windowBackground）；父主题用框架 Theme.Material.Light.NoActionBar
       （无外部 material 依赖，LSPFRIDA 的 Theme.Material3.DayNight 需 com.google.android.material；
       系栏样式由 enableEdgeToEdge 运行时接管，深浅切帧由 values-night 背景覆盖） -->
  <style name="Base.AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
    <!-- 显式窗口背景：Compose 帧间隙/首帧透出的窗口层底色 -->
    <item name="android:windowBackground">@color/window_background</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">true</item>
  </style>

  <style name="AppTheme" parent="Base.AppTheme" />
</resources>