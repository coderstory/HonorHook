    <string name="feature_market_purify_mine_feed_title">去我的页推荐流</string>
    <string name="feature_market_purify_mine_feed_desc">「我的」页面不再加载运营推荐信息流（返回空数据，不是藏 UI）</string>
    <string name="feature_market_purify_search_feed_title">去搜索页推荐流</string>
