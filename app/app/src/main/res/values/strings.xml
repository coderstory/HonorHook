    <string name="feature_market_purify_silent_upd_title">拦静默更新任务</string>
    <string name="feature_market_purify_silent_upd_desc">禁止市场在后台静默下载与预下载更新（默认关）</string>
    <string name="feature_market_purify_update_notify_title">拦更新提醒通知</string>
