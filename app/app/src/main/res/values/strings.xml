    <string name="feature_market_purify_tab_apps_title">去应用页签</string>
    <string name="feature_market_purify_tab_apps_desc">底部导航移除应用页签（默认关）</string>
    <string name="feature_market_purify_tab_category_title">去分类页签</string>
    <string name="feature_market_purify_tab_category_desc">底部导航移除分类页签（默认关）</string>
    <string name="feature_market_purify_tab_mine_title">去我的页签</string>
    <string name="feature_market_purify_tab_mine_desc">底部导航移除「我的」页签及其关联活动入口（默认关）</string>
    <string name="feature_market_purify_home_rollword_title">去首页滚动词</string>
    <string name="feature_market_purify_home_rollword_desc">首页标题下的运营滚动播报不再显示（默认关）</string>
    <string name="feature_market_purify_mine_signin_title">去我的页签到入口</string>
    <string name="feature_market_purify_mine_signin_desc">隐藏「我的」页面的每日签到卡片（默认关）</string>
    <string name="feature_market_purify_mine_safety_title">去我的页安全检测卡</string>
    <string name="feature_market_purify_mine_safety_desc">隐藏「我的」页面的安全检测/风险提示卡片（默认关）</string>
    <string name="feature_market_purify_mine_clean_title">去我的页清理加速卡</string>
    <string name="feature_market_purify_mine_clean_desc">隐藏「我的」页面的垃圾清理/加速推广卡片（默认关）</string>
    <string name="feature_market_purify_mine_services_title">去我的页服务推荐</string>
    <string name="feature_market_purify_mine_services_desc">隐藏「我的」页面的服务推荐区块（默认关）</string>
    <string name="feature_market_purify_mine_slide_title">去我的页滑动引导</string>
