<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- miuix-blur 声明 minSdk 33（RuntimeShader 折射高光），但项目需覆盖到 API 26。
         该库只在 `Build.VERSION.SDK_INT >= 33` 时被调用（见 MainActivity/FloatingBottomBar 的
         `enableBlurSdk` 守卫），低版本走实色底栏，故可安全 override，不会有 NoSuchMethodError。 -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <!-- Android 11(API 30) 包可见性：模块需要读取 6 个宿主应用的 label/icon 才能渲染功能列表。
         系统应用（settings / systemui / launcher / thememanager / packageinstaller）默认可见，
         但**用户安装的应用**（如 com.exam8.chengrenGK）在未声明时 getApplicationInfo() 直接返回 null，
         图标会退化成首字母色块。QUERY_ALL_PACKAGES 是 LSPosed 类模块读取宿主应用的标准做法。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- 在线更新：app 内下载 release APK 后交给系统安装器（REQUEST_INSTALL_PACKAGES
         只是声明权，安装前还有「允许安装未知应用」的用户授权页，见 ApkInstaller.install）。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- MFA 验证器扫码（2026-11-03）：CameraX 取景 + zxing 解码 otpauth 二维码。 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 文件整理（2026-11-04，工具箱 FILES 页）：跨应用媒体移动 + 全盘空目录清理
         在 MediaStore-only 模型下做不到（审计 D-M7 架构级结论），唯一路线 = 全文件访问，
         用户在系统设置里手动授权（rules v2 §0）。声明之外还需运行时引导，见 FileOrganizerScreen。 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- 小红书批量下载前台服务（2026-11-11）：退后台继续下载的保活壳，见 ui/xhsbatch/XhsBatchService.kt -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 小红书批量下载后台保活：电池优化白名单弹窗（荣耀 PowerKeeper 杀后台实锤） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Android 13+ 运行时权限：缺它 FGS 常驻通知全被拦（dumpsys numBlocked=646 实锤，2026-11-11） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 纯 hook 模块：无 Activity、无图标、无 launcher 入口、无主题资源。
         仅保留 Xposed 基础标识供 LSPosed Manager 识别与激活。

         android:label / android:description 是 **LSPosed Manager 实际读取的字段**（实证见下）：
         LSPosed `ModuleUtil.InstalledModule.getAppName()/getDescription()`（reference/LSPosed（框架源码）
         app/.../util/ModuleUtil.java:322/347）—— 现代模块（有 META-INF/xposed/module.prop）走
         `app.loadLabel(pm)` / `app.loadDescription(pm)`，即**清单里 application 的 label / description**；
         module.prop 的 `description=` 键**不被 LSPosed Manager 读取**（它只读 minApiVersion/targetApiVersion/staticScope）。
         注意 `android:description` 属性格式是 reference（只接受 @string 引用，字面量会被 aapt2 拒绝），
         故简介落在 res/values/strings.xml 的 `module_description`。label 可直接字面量。 -->
    <application
        android:name=".ui.HonorHookApp"
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Re:荣耀"
        android:theme="@style/Theme.HonorHook">

        <!-- Xposed 基础标识（兼容旧框架探测；现代 LSPosed 走 META-INF/xposed/*） -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="重新编译你的荣耀体验——系统深处，由你执笔。" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />

        <!-- 小红书批量下载保活（dataSync 类型，API 34 要求显式声明 foregroundServiceType） -->
        <service
            android:name=".ui.xhsbatch.XhsBatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 下载的更新 APK 经 FileProvider 交给系统安装器（cacheDir/update/） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 宿主设置界面：三 Tab（首页/功能/设置），Miuix Compose 实现 -->
        <activity
            android:name=".ui.webscan.WebScanActivity"
            android:exported="false"
            android:label="远程开发"
            android:launchMode="singleTask"
            android:taskAffinity="top.honorhook.webscan" />
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="Re:荣耀"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
